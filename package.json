{
  "name": "genesite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "validate": "vitest run tests/content-schema.test.ts tests/content-validation.test.ts",
    "test": "npm run validate && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/content-identity.test.ts tests/content-selectors.test.ts tests/labels.test.ts",
    "test:integration": "vitest run tests/content-identity.integration.test.ts",
    "test:artifact": "vitest run tests/production-artifact.test.ts tests/phase-2-artifact.test.ts",
    "test:production-cutover": "vitest run tests/production-cutover-artifact.test.ts",
    "build": "astro build",
    "build:fixtures": "GENESITE_INCLUDE_FIXTURES=true astro build",
    "verify": "npm run format:check && npm run check && npm run validate && npm run test:unit && npm run test:integration && npm run build:fixtures && npm run test:artifact && npm run build && npm run test:production-cutover"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.3",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
