---
import { render, type CollectionEntry } from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
import {
  getPublicRelatedWritings,
  getPublicWritings,
  loadValidatedWritings,
} from '../../lib/content';

export async function getStaticPaths() {
  const writings = await getPublicWritings();

  return writings.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'writings'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedWritings = getPublicRelatedWritings(
  entry,
  await loadValidatedWritings(),
);
---

<WritingLayout entry={entry} relatedWritings={relatedWritings}>
  <Content />
</WritingLayout>
