---
import WritingCard from '../components/WritingCard.astro';
import { PRIMARY_LANGUAGE, SITE_NAME } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDiscoverableWritings } from '../lib/content';
import { getUiLabels } from '../lib/labels';

const writings = await getDiscoverableWritings();
const labels = getUiLabels(PRIMARY_LANGUAGE);
---

<BaseLayout
  title={`${SITE_NAME} — ${labels.siteDescription}`}
  description={labels.homeDescription}
  language={PRIMARY_LANGUAGE}
>
  <div class="wide-shell">
    <header class="home-intro">
      <p class="home-intro__kicker">{labels.homeKicker}</p>
      <h1>{labels.homeTitle}</h1>
      <p class="home-intro__description">{labels.homeDescription}</p>
    </header>

    <section class="writing-selection" aria-labelledby="selected-writings">
      <header class="writing-selection__header">
        <p class="section-kicker">GeneSite</p>
        <h2 id="selected-writings">{labels.selectedWritings}</h2>
        <p>{labels.selectedWritingsDescription}</p>
      </header>
      <div class="writing-list" data-public-writing-index>
        {
          writings.map((writing) => (
            <WritingCard entry={writing} interfaceLanguage={PRIMARY_LANGUAGE} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
